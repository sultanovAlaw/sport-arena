# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_USERNAME: Optional admin login identifier (defaults to admin@sportarena.uz if ADMIN_PASSWORD is set).
ADMIN_USERNAME=

# ADMIN_PASSWORD: Optional server-side admin password override. If left empty, claim admin access via the first-run setup form in the Admin tab.
ADMIN_PASSWORD=

# SESSION_SECRET: Optional secret for signing authentication tokens (auto-generated in memory if omitted).
SESSION_SECRET=
